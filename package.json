{
  "name": "pishkhan-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "generate:client": "pnpm --filter @pishkhan/api-client generate",
    "contract-check": "bash scripts/contract-check.sh",
    "optimize:images": "vitest run scripts/optimize-images.test.ts",
    "check:images": "node -e \"import('./scripts/check-image-budget.ts').then(m => m.verifyImageBudget()).then(r => console.log('Budget verified:', r.allFilesPassed && r.homePagePassed))\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/sharp": "^0.32.0",
    "blurhash": "^2.0.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "sharp": "^0.35.4",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
